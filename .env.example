# Optional settings for your own PowerShell session. No keys are needed for local use.
# PORT=8081
# LIFECYCLE_TEAM_DATA_DIR=C:\path\to\your\team-data

# Local accounts are on by default; set this to off to skip the login gate.
# Accounts only confirm who is using this computer: every account shares the same local data.
# LOCAL_ACCOUNTS=off

# Optional AI recognition for the quick-record TEXT input (all five modules).
# Without a provider or key every module keeps its offline text rules.
# This file is a template; the app also loads a real .env from the project root.
# Real environment variables win over .env values.
#
# AI_PROVIDER picks a preset endpoint/model:
#   ollama     free, keyless, local Ollama at http://127.0.0.1:11434/v1 (model qwen2.5:7b)
#   zhipu      free tier, key required, GLM-4-Flash
#   openrouter free model, key required, meta-llama/llama-3.3-70b-instruct:free
#   deepseek / moonshot / dashscope / openai / custom
# AI_PROVIDER=ollama
# AI_API_KEY=sk-your-key
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-5.4-mini
# AI_API_MODE=responses

# Photo and voice recognition stay opt-in and are outside the text quick-record scope.
# AI_MEDIA=1
# AI_TRANSCRIBE_MODEL=gpt-transcribe

# Older names keep working; AI_* wins when both are set.
# OPENAI_API_KEY=sk-your-key
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_FOOD_MODEL=gpt-5.4-mini
# OPENAI_DRUG_MODEL=gpt-5.4-mini
# OPENAI_CLOTHING_MODEL=gpt-5.4-mini
# OPENAI_DEVICE_MODEL=gpt-5.4-mini
# OPENAI_SUBSCRIPTION_MODEL=gpt-5.4-mini
# OPENAI_TRANSCRIBE_MODEL=gpt-transcribe
